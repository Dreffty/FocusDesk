<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>FocusDesk</AssemblyName>
    <RootNamespace>FocusDesk.Windows</RootNamespace>
    <Version>1.1.1</Version>
    <Product>FocusDesk</Product>
    <Company>Articdia</Company>
    <Description>Agenda, bloqueo de distracciones y reglas estudio-partida para Windows</Description>
    <!-- The same icon as the Mac app (made from Resources/AppIcon.icns): the .exe, the taskbar and every window. -->
    <ApplicationIcon>FocusDesk.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also inside the program, for the notification-area icon. -->
    <Resource Include="FocusDesk.ico" />
  </ItemGroup>
</Project>
