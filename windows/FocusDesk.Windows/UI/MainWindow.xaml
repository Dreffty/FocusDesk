<Window x:Class="FocusDesk.Windows.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusDesk" Width="1160" Height="780" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0F1218" Foreground="#F2F5FA">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#131820" BorderBrush="#283140" BorderThickness="0,0,1,0" Padding="14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6,8,6,20">
          <TextBlock Text="FocusDesk" FontSize="20" FontWeight="Bold" Foreground="#64E3A1"/>
          <TextBlock Text="Windows · Bloqueo y foco" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,4">
          <TextBlock x:Name="SidebarStudyText" Text="Estudio hoy: 00:00" FontSize="12" Foreground="#64E3A1" FontWeight="SemiBold"/>
          <TextBlock x:Name="SidebarGuardText" Text="Vigilante: apagado" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel x:Name="NavStack">
          <Button Content="Hoy" Tag="Hoy" Click="NavClick" Margin="0,2" HorizontalContentAlignment="Left"/>
          <Button Content="Semana" Tag="Semana" Click="NavClick" Margin="0,2" HorizontalContentAlignment="Left"/>
          <Button Content="Reglas y juegos" Tag="Reglas" Click="NavClick" Margin="0,2" HorizontalContentAlignment="Left"/>
          <Button Content="Bloquear" Tag="Bloquear" Click="NavClick" Margin="0,2" HorizontalContentAlignment="Left"/>
          <Button Content="Descansos" Tag="Descansos" Click="NavClick" Margin="0,2" HorizontalContentAlignment="Left"/>
          <Button Content="Historial" Tag="Historial" Click="NavClick" Margin="0,2" HorizontalContentAlignment="Left"/>
          <Button Content="Ajustes" Tag="Ajustes" Click="NavClick" Margin="0,2" HorizontalContentAlignment="Left"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top Banner -->
      <Border x:Name="NoticeBanner" Grid.Row="0" Background="#171C24" BorderBrush="#283140" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cerrar" Click="DismissNoticeClick" Padding="8,2"/>
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#64E3A1" Margin="0,0,12,0"/>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageContent" Margin="0,0,8,0"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
