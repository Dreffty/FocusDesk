<Window x:Class="FocusDesk.Windows.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusDesk" Width="1240" Height="820" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="#0D1014" Foreground="#EDF2F5">
  <!-- Same layout as FocusDesk for macOS: sidebar with the logo, search, sections with icons, the running session
       and the global shortcut; on the right a fixed header (date + headline) over the scrolling page. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="244"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#0B0D11" BorderBrush="#1C1F24" BorderThickness="0,0,1,0" Padding="14,22,14,14">
      <DockPanel LastChildFill="True">
        <!-- Logo -->
        <Grid DockPanel.Dock="Top" Margin="4,4,4,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="9" Background="#38A169" VerticalAlignment="Center">
            <Grid Width="20" Height="20">
              <Ellipse Stroke="#0D1014" StrokeThickness="2" Width="15" Height="15"/>
              <Ellipse Fill="#0D1014" Width="5" Height="5"/>
              <Rectangle Fill="#0D1014" Width="2" Height="4" VerticalAlignment="Top"/>
              <Rectangle Fill="#0D1014" Width="2" Height="4" VerticalAlignment="Bottom"/>
              <Rectangle Fill="#0D1014" Width="4" Height="2" HorizontalAlignment="Left"/>
              <Rectangle Fill="#0D1014" Width="4" Height="2" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="focusdesk" FontSize="19" FontWeight="SemiBold" Foreground="#EDF2F5"/>
            <TextBlock Text="Menos ruido. Más foco." FontSize="12.5" Foreground="#99A6AD" Margin="0,1,0,0"/>
          </StackPanel>
        </Grid>

        <!-- Search: opens the command palette (Ctrl+K) -->
        <Button x:Name="SearchButton" DockPanel.Dock="Top" Click="SearchClick" Margin="0,0,0,18" Padding="10,0"
                MinHeight="34" Background="#12151A" BorderBrush="#2A2E34" HorizontalContentAlignment="Stretch">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#99A6AD" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Buscar función…" Foreground="#99A6AD" FontWeight="Normal" Margin="9,0,0,0" VerticalAlignment="Center"/>
            <Border Grid.Column="2" Background="#1D2229" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
              <TextBlock Text="Ctrl K" FontSize="12" Foreground="#99A6AD" FontWeight="SemiBold"/>
            </Border>
          </Grid>
        </Button>

        <!-- Footer: global shortcut, today's study and the watcher -->
        <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,0">
          <TextBlock x:Name="SidebarStudyText" Text="Estudio hoy: 00:00" FontSize="12.5" Foreground="#99A6AD"/>
          <TextBlock x:Name="SidebarGuardText" Text="Vigilante: apagado" FontSize="12.5" Foreground="#99A6AD" Margin="0,2,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16.5" Foreground="#99A6AD" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Abrir desde cualquier app" FontSize="12.5" Foreground="#99A6AD" Margin="9,0,6,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Border Grid.Column="2" Background="#1D2229" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
              <TextBlock x:Name="HotKeyChipText" Text="Ctrl+Alt+Win+F" FontSize="12" Foreground="#99A6AD" FontWeight="SemiBold"/>
            </Border>
          </Grid>
        </StackPanel>

        <!-- Running session (only while there is one) -->
        <Border x:Name="SidebarSessionCard" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="#161B21" BorderBrush="#262A30"
                BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,12,0,0">
          <StackPanel>
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="#38A169" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="SidebarSessionState" Text="EN SESIÓN" FontSize="12" FontWeight="SemiBold" Foreground="#99A6AD"/>
              </StackPanel>
              <Button Click="SidebarOpenSessionClick" HorizontalAlignment="Right" Padding="6,2" MinHeight="24" ToolTip="Ir a la sesión">
                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"/>
              </Button>
            </Grid>
            <TextBlock x:Name="SidebarSessionTitle" FontSize="15" FontWeight="SemiBold" Foreground="#EDF2F5" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
            <Border x:Name="SidebarSessionPhaseChip" Background="#15291F" CornerRadius="7" Padding="7,2" Margin="0,7,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
              <TextBlock x:Name="SidebarSessionPhase" FontSize="12.5" FontWeight="SemiBold" Foreground="#38A169"/>
            </Border>
            <TextBlock x:Name="SidebarSessionClock" Text="00:00" FontSize="30" FontWeight="SemiBold" Foreground="#38A169" Margin="0,6,0,8"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="SidebarPauseButton" Click="SidebarPauseClick" Padding="9,0" MinHeight="32" Margin="0,0,6,0" ToolTip="Pausar o reanudar">
                <TextBlock x:Name="SidebarPauseGlyph" Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
              </Button>
              <Button Grid.Column="1" Click="SidebarAddTimeClick" Padding="9,0" MinHeight="32" Margin="0,0,6,0" ToolTip="Añadir 10 minutos">
                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
              </Button>
              <Button Grid.Column="2" Click="SidebarFinishClick" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="10,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <TextBlock Text="Terminar" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Sections (built in code with their icons and counters) and «Nueva tarea» -->
        <StackPanel>
          <StackPanel x:Name="NavStack"/>
          <Button Click="SidebarNewTaskClick" Margin="0,14,0,0" MinHeight="36" Background="#12151A" BorderBrush="#2A2E34">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock Text="Nueva tarea" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content: fixed header, notice, scrolling page -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="#1C1F24" BorderThickness="0,0,0,1" Padding="34,26,34,18">
        <ContentControl x:Name="HeaderHost" Focusable="False"/>
      </Border>

      <Border x:Name="NoticeBanner" Grid.Row="1" Background="#161B21" BorderBrush="#262A30" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="34,16,34,0" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cerrar" Click="DismissNoticeClick" Padding="10,4" MinHeight="28" FontSize="13"/>
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#38A169" FontSize="14" Margin="0,0,14,0"/>
        </DockPanel>
      </Border>

      <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageContent" Margin="34,22,30,30"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
