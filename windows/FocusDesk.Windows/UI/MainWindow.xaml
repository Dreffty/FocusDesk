<Window x:Class="FocusDesk.Windows.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusDesk" Width="1180" Height="800" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14" Foreground="#F2F5FA">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#080A0F" BorderBrush="#242E40" BorderThickness="0,0,1,0" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6,6,6,20">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Fill="#64E3A1" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock Text="FocusDesk" FontSize="20" FontWeight="Bold" Foreground="#F2F5FA"/>
          </StackPanel>
          <TextBlock Text="Windows · Agenda y bloqueo" FontSize="11.5" Foreground="#94A3B8" Margin="19,2,0,0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Background="#131822" BorderBrush="#242E40" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock x:Name="SidebarStudyText" Text="Estudio hoy: 00:00" FontSize="12" Foreground="#64E3A1" FontWeight="SemiBold"/>
            <TextBlock x:Name="SidebarGuardText" Text="Vigilante: apagado" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel x:Name="NavStack">
          <TextBlock Text="AGENDA" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="10,0,0,6"/>
          <Button Content="Hoy" Tag="Hoy" Click="NavClick" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left"/>
          <Button Content="Semana" Tag="Semana" Click="NavClick" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left"/>
          <Button Content="Historial" Tag="Historial" Click="NavClick" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left"/>

          <TextBlock Text="ANTIDISTRACCIÓN" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="10,16,0,6"/>
          <Button Content="Reglas y juegos" Tag="Reglas" Click="NavClick" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left"/>
          <Button Content="Bloquear ahora" Tag="Bloquear" Click="NavClick" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left"/>
          <Button Content="Descansos" Tag="Descansos" Click="NavClick" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left"/>

          <Border Height="1" Background="#1B2230" Margin="6,14,6,10"/>
          <Button Content="Ajustes" Tag="Ajustes" Click="NavClick" Margin="0,2" Padding="12,8" HorizontalContentAlignment="Left"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" Margin="26,22,26,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top Banner -->
      <Border x:Name="NoticeBanner" Grid.Row="0" Background="#131822" BorderBrush="#242E40" BorderThickness="1" CornerRadius="11" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cerrar" Click="DismissNoticeClick" Padding="10,4" MinHeight="28" FontSize="12"/>
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#64E3A1" FontSize="13" Margin="0,0,14,0"/>
        </DockPanel>
      </Border>

      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageContent" Margin="0,0,10,0"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
